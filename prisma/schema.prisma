generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Restaurant {
  id                         String        @id @default(cuid())
  name                       String
  address                    String?
  phone                      String?
  gstin                      String?
  cgst_rate                  Float         @default(2.5)
  sgst_rate                  Float         @default(2.5)
  logo_url                   String?
  theme_color                String?
  custom_domain              String?       @unique
  max_staff_profiles         Int           @default(5)
  fssai_no                   String?
  bill_footer_msg            String?       @default("Thank you for visiting! Have a nice day.")
  bill_template_config       String?
  subscription_end_date      DateTime?
  subscription_status        String        @default("ACTIVE")
  swiggy_enabled             Boolean       @default(false)
  swiggy_api_key             String?
  zomato_enabled             Boolean       @default(false)
  zomato_api_key             String?
  created_at                 DateTime      @default(now())
  updated_at                 DateTime      @updatedAt
  daily_email_report_address String?
  daily_email_report_enabled Boolean       @default(false)
  categories                 Category[]
  kot_tickets                KOTTicket[]
  menu_items                 MenuItem[]
  orderItems                 OrderItem[]
  orders                     Order[]
  platform_logs              PlatformLog[]
  saas_payments              SaaSPayment[]
  subscription_history       SubscriptionHistory[]
  checkout_sessions          CheckoutSession[]
  staff                      Staff[]
  tables                     Table[]
  raw_materials              RawMaterial[]
  support_tickets            SupportTicket[]
  addons                     AddOn[]

  @@map("restaurants")
}

model Table {
  id             String     @id @default(cuid())
  table_number   String
  capacity       Int        @default(4)
  area           String     @default("INDOOR")
  status         String     @default("AVAILABLE")
  merged_with_id String?
  restaurant_id  String
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  orders         Order[]
  merged_with    Table?     @relation("MergedTables", fields: [merged_with_id], references: [id])
  merged_tables  Table[]    @relation("MergedTables")
  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id])

  @@unique([restaurant_id, table_number])
  @@map("tables")
}

model Category {
  id            String     @id @default(cuid())
  name          String
  sort_order    Int        @default(0)
  is_active     Boolean    @default(true)
  restaurant_id String
  created_at    DateTime   @default(now())
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id])
  menu_items    MenuItem[]

  @@map("categories")
}

model MenuItem {
  id            String      @id @default(cuid())
  category_id   String
  name          String
  description   String?
  price         Float
  variants      Json?
  food_type     String      @default("VEG")
  is_available  Boolean     @default(true)
  is_deleted    Boolean     @default(false)
  image_url     String?
  restaurant_id String
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  category      Category    @relation(fields: [category_id], references: [id])
  restaurant    Restaurant  @relation(fields: [restaurant_id], references: [id])
  order_items   OrderItem[]
  price_logs    PriceLog[]
  recipes       Recipe[]

  @@map("menu_items")
}

model PriceLog {
  id           String   @id @default(cuid())
  menu_item_id String
  old_price    Float
  new_price    Float
  changed_by   String
  changed_at   DateTime @default(now())
  menu_item    MenuItem @relation(fields: [menu_item_id], references: [id])

  @@map("price_logs")
}

model Staff {
  id                     String      @id @default(cuid())
  name                   String
  email                  String      @unique
  password               String
  role                   String      @default("WAITER")
  pin                    String
  is_active              Boolean     @default(true)
  has_seen_tour          Boolean     @default(false)
  restaurant_id          String?
  password_reset_token   String?     @unique
  password_reset_expires DateTime?
  orders                 Order[]
  restaurant             Restaurant? @relation(fields: [restaurant_id], references: [id])

  @@map("staff")
}

model Order {
  id              String      @id @default(cuid())
  table_id        String?
  staff_id        String
  invoice_number  String      @unique
  guest_count     Int         @default(1)
  status          String      @default("OPEN")
  subtotal        Float       @default(0)
  cgst_amount     Float       @default(0)
  sgst_amount     Float       @default(0)
  discount_amount Float       @default(0)
  total_amount    Float       @default(0)
  payment_mode    String?
  payment_status  String      @default("PENDING")
  paid_at         DateTime?
  order_type      String      @default("DINE_IN")
  external_id     String?
  notes           String?
  kot_requested   Boolean     @default(false)
  bill_requested  Boolean     @default(false)
  prep_start_time DateTime?
  prep_end_time   DateTime?
  restaurant_id   String
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  kot_tickets     KOTTicket[]
  order_items     OrderItem[]
  restaurant      Restaurant  @relation(fields: [restaurant_id], references: [id])
  staff           Staff       @relation(fields: [staff_id], references: [id])
  table           Table?      @relation(fields: [table_id], references: [id])

  @@map("orders")
}

model OrderItem {
  id            String     @id @default(cuid())
  order_id      String
  menu_item_id  String
  quantity      Int        @default(1)
  unit_price    Float
  total_price   Float
  notes         String?
  variant_name  String?
  status        String     @default("PENDING")
  restaurant_id String
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  menu_item     MenuItem   @relation(fields: [menu_item_id], references: [id])
  order         Order      @relation(fields: [order_id], references: [id])
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [id])

  @@map("order_items")
}

model SaaSPayment {
  id             String     @id @default(cuid())
  restaurant_id  String
  amount         Float
  payment_date   DateTime   @default(now())
  payment_method String
  reference_no   String?
  notes          String?
  created_by     String
  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id])

  @@map("saas_payments")
}

model PlatformLog {
  id            String      @id @default(cuid())
  action        String
  description   String
  restaurant_id String?
  performed_by  String
  created_at    DateTime    @default(now())
  restaurant    Restaurant? @relation(fields: [restaurant_id], references: [id])

  @@map("platform_logs")
}

model KOTTicket {
  id           String      @id @default(cuid())
  order_id     String
  kot_number   String
  items        String
  printed_at   DateTime    @default(now())
  restaurantId String?
  order        Order       @relation(fields: [order_id], references: [id])
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])

  @@map("kot_tickets")
}

model DailyReport {
  id              String   @id @default(cuid())
  report_date     DateTime @unique
  total_orders    Int      @default(0)
  total_revenue   Float    @default(0)
  total_gst       Float    @default(0)
  cash_collected  Float    @default(0)
  upi_collected   Float    @default(0)
  card_collected  Float    @default(0)
  avg_order_value Float    @default(0)
  created_at      DateTime @default(now())

  @@map("daily_reports")
}

model SubscriptionHistory {
  id                  String   @id @default(cuid())
  invoice_number      String   @unique
  plan_name           String
  plan_type           String   @default("ANNUAL")
  billing_cycle       String?
  amount              Float
  tax_amount          Float    @default(0)
  total_amount        Float
  currency            String   @default("INR")
  payment_method      String   @default("UPI")
  payment_status      String   @default("PAID")
  transaction_id      String?
  razorpay_payment_id String?
  event_type          String   @default("RENEWAL")
  starts_at           DateTime
  ends_at             DateTime
  notes               String?
  restaurant_id       String?
  restaurant          Restaurant? @relation(fields: [restaurant_id], references: [id])
  created_at          DateTime @default(now())

  @@map("subscription_history")
}

model CheckoutSession {
  id                String   @id @default(cuid())
  plan_name         String
  plan_type         String
  amount            Float
  tax_amount        Float
  total_amount      Float
  status            String   @default("PENDING")
  razorpay_order_id String?
  restaurant_id     String?
  restaurant        Restaurant? @relation(fields: [restaurant_id], references: [id])
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("checkout_sessions")
}

model PlatformSettings {
  id                        String   @id @default("global")
  platform_name             String   @default("BitePoint")
  default_subscription_days Int      @default(365)
  default_cgst_rate         Float    @default(2.5)
  default_sgst_rate         Float    @default(2.5)
  support_email             String   @default("support@bitepoint.com")
  updated_at                DateTime @updatedAt

  @@map("platform_settings")
}

model RawMaterial {
  id               String         @id @default(cuid())
  restaurant_id    String
  name             String
  unit_type        String         // e.g., "g", "ml", "unit", "kg"
  current_stock    Float          @default(0)
  low_stock_alert  Float          @default(10)
  is_active        Boolean        @default(true)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  
  restaurant       Restaurant     @relation(fields: [restaurant_id], references: [id])
  recipes          Recipe[]
  inventory_logs   InventoryLog[]

  @@map("raw_materials")
}

model Recipe {
  id               String       @id @default(cuid())
  menu_item_id     String
  raw_material_id  String
  quantity_needed  Float        // Amount of raw material needed for 1 menu item
  
  menu_item        MenuItem     @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  raw_material     RawMaterial  @relation(fields: [raw_material_id], references: [id], onDelete: Cascade)

  @@unique([menu_item_id, raw_material_id])
  @@map("recipes")
}

model InventoryLog {
  id               String       @id @default(cuid())
  raw_material_id  String
  action           String       // "ADD", "DEDUCT", "SET", "ORDER_CONSUMPTION"
  quantity         Float
  previous_stock   Float
  new_stock        Float
  notes            String?
  performed_by     String       // User ID or "SYSTEM"
  created_at       DateTime     @default(now())

  raw_material     RawMaterial  @relation(fields: [raw_material_id], references: [id], onDelete: Cascade)

  @@map("inventory_logs")
}

model SupportTicket {
  id            String      @id @default(cuid())
  restaurant_id String
  subject       String
  description   String
  status        String      @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority      String      @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  created_by    String      // Staff ID who created it
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  restaurant    Restaurant  @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model BroadcastMessage {
  id            String      @id @default(cuid())
  title         String
  message       String
  type          String      @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  is_active     Boolean     @default(true)
  created_by    String      // Super Admin ID
  expires_at    DateTime?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  @@map("broadcast_messages")
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  duration    Int      // months
  price       Float
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("subscription_plans")
}

model AddOn {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  restaurants Restaurant[]

  @@map("add_ons")
}
